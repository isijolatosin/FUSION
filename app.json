{
  "expo": {
    "name": "wiingr",
    "slug": "wiingr-app",
    "description": "Wiingr app is a social application for african community",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.tosin.wiingrapp",
      "buildNumber": "1.0.8",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Wiingr requires access to your camera to enable photo and video capture for creating and sharing content.",
        "NSLocationAlwaysUsageDescription": "By allowing us to access your location, we can better match you with individuals who are nearby and share similar interests.",
        "NSPhotoLibraryUsageDescription": "To personalize your experience, wiingr requires access to your photo library to enable photo uploads and sharing with friends.."
      }
    },
    "android": {
      "package": "com.tosin.wiingrapp",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Wiingr to access this device's location."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c8a2c8c5-e0d7-415d-88cd-83c85489de5b",
        "baseurl": "https://www.wiingr.com/",
        "adminKey": "ADMIN"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c8a2c8c5-e0d7-415d-88cd-83c85489de5b"
    }
  }
}
