{
  "expo": {
    "name": "FUSION",
    "slug": "FUSION",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/fusion_logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/fusion_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/fusion_logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/fusion_logo.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Your Fusion to access this device's location."
        }
      ]
    ]
  }
}
