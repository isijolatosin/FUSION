rules_version = '2';

// Firestore rules for the Wiingr relaunch.
// NOT deployed yet: the live database is locked (deny all) while the app is
// off the App Store. Publish these from the Firebase console (Firestore > Rules)
// or with `firebase deploy --only firestore:rules` when the app goes live again.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tokenPhone() {
      return request.auth.token.get('phone_number', null);
    }

    function tokenEmail() {
      return request.auth.token.get('email', null);
    }

    // User documents are created with .add() (random IDs), so ownership is
    // checked by matching the signed-in phone number (phone sign-in) or email
    // (email/password sign-in) against the profile.
    function isOwner(data) {
      return signedIn() && (
        (tokenPhone() != null && data.get('phonenumber', null) == tokenPhone()) ||
        (tokenEmail() != null && data.get('email', null) == tokenEmail())
      );
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // `role` (e.g. "ADMIN") is only ever set by hand in the Firebase console,
    // which bypasses these rules. Nobody can set or change it from the app.
    function touchesProtectedFields() {
      return changedKeys().hasAny(['role', 'phonenumber']);
    }

    // The only fields the app writes on OTHER people's profiles
    // (likes, blocks and in-app notifications).
    function onlySharedFields() {
      return changedKeys().hasOnly([
        'likedMeList',
        'listOfAllLikedNumbers',
        'blockedMeList',
        'inAppNotification'
      ]);
    }

    match /all-users/{userId} {
      allow read: if signedIn();

      // New profile: must be your own phone number or email, and no role.
      allow create: if isOwner(request.resource.data)
        && !('role' in request.resource.data);

      // Your own profile: edit anything except role and phone number.
      // Someone else's profile: only the shared like/block/notification fields.
      allow update: if signedIn()
        && !touchesProtectedFields()
        && (isOwner(resource.data) || onlySharedFields());

      // Only the owner can delete their profile.
      allow delete: if isOwner(resource.data);
    }

    // Everything else (chats, likes, matches, communities, events, support,
    // reports, meal plans, exercise data): signed-in users only.
    match /{collection}/{docId=**} {
      allow read, write: if signedIn() && collection != 'all-users';
    }
  }
}
